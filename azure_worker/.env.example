# Copy this file to azure_worker/.env and fill in real values.
# azure_worker/.env is gitignored.

# --- Required: Azure ---

# Full connection string from the Azure Storage account (must include AccountKey
# so the worker can mint SAS tokens; pure SAS-bound strings will not work).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=REPLACE_ME;AccountKey=REPLACE_ME;EndpointSuffix=core.windows.net

# Storage Queue holding incoming image-generation requests.
AZURE_INBOUND_QUEUE=image-requests

# Storage Queue where results (success or error) are posted.
AZURE_OUTBOUND_QUEUE=image-results

# Blob container that will hold generated PNGs (and overflow LLM completions).
AZURE_BLOB_CONTAINER=generated-images

# --- Required: LLM queues + Ollama endpoint ---

# Storage Queue carrying inbound LLM (chat-completion) requests.
LLM_INBOUND_QUEUE=llm-requests

# Storage Queue where LLM results are posted.
LLM_OUTBOUND_QUEUE=llm-results

# Base URL of a running Ollama daemon. The worker POSTs to {OLLAMA_URL}/api/chat
# (native API — the OpenAI-compat /v1 path silently ignores the `think` toggle
# for Qwen3-family models, so we use the native path). Ollama must be running
# separately (Windows tray icon or `ollama serve`).
OLLAMA_URL=http://localhost:11434

# Per-request HTTP timeout for the Ollama call. Big context + thinking models
# can take a long time; bump this if you see timeouts.
# LLM_REQUEST_TIMEOUT_SECONDS=300

# --- Required: Model profile selection ---

# Which pipeline the worker should load on startup.
# Valid values: flux1-dev | flux2-klein | chroma1 | fluxed-up | qwen-image-2512 | qwen-image-2.1 | openflux1 | qwen-rapid-aio | sdxl-dreamshaper
# All nine profile blocks below are read on startup; only the active profile's
# files are actually loaded into VRAM. Changing this requires restarting the
# worker (models are pinned in VRAM for the process lifetime).
COMFY_PROFILE=flux1-dev

# --- Required: Flux 1 dev files (under models/diffusion_models/, models/text_encoders/, models/vae/) ---

COMFY_FLUX1_UNET=flux1-dev.safetensors
COMFY_FLUX1_CLIP_L=clip_l.safetensors
COMFY_FLUX1_T5=t5xxl_fp16.safetensors
COMFY_FLUX1_VAE=ae.safetensors

# --- Required: Flux 2 Klein files ---

COMFY_FLUX2_UNET=flux-2-klein-9b-fp8.safetensors
# ComfyUI auto-detects 4B vs 8B Qwen variant from the safetensors header.
COMFY_FLUX2_CLIP=qwen_3_8b_fp8mixed.safetensors
COMFY_FLUX2_VAE=full_encoder_small_decoder.safetensors

# --- Required: Chroma1 files ---
# Chroma1 is a de-distilled Flux derivative — T5 only, real CFG, beta scheduler.
# Sampling defaults (steps/cfg/sampler/scheduler/shift) live in profiles.toml.
COMFY_CHROMA_UNET=Chroma1-HD-fp8mixed.safetensors
COMFY_CHROMA_CLIP=t5xxl_fp16.safetensors
COMFY_CHROMA_VAE=ae.safetensors

# --- Required: Fluxed Up files ---
# Fluxed Up is an NSFW Flux 1 dev finetune. Same architecture, so it reuses
# COMFY_FLUX1_CLIP_L, COMFY_FLUX1_T5, and COMFY_FLUX1_VAE above — only the
# UNet differs. The file is fp8-mixed quantized; the workflow loads it with
# weight_dtype=fp8_e4m3fn automatically.
COMFY_FLUXEDUP_UNET=fluxedUpFluxNSFW_40DevFp8.safetensors

# --- Required: Qwen-Image 2512 files ---
# Qwen-Image is from Alibaba (Tongyi). Uses Qwen 2.5 VL 7B as text encoder
# (NOT the Qwen3 encoders used by Flux 2 Klein — different model family).
# Real CFG and real negative prompt are honored (like chroma1).
# Sampling defaults (steps/cfg/sampler/scheduler) live in profiles.toml.
COMFY_QWEN_UNET=qwen_image_2512_fp8_e4m3fn.safetensors
COMFY_QWEN_CLIP=qwen_2.5_vl_7b_fp8_scaled.safetensors
COMFY_QWEN_VAE=qwen_image_vae.safetensors

# --- Required: Qwen-Image 2.1 files ---
# Alibaba Qwen-Image 2.1 (Sept 2026). Different encoder again: a Qwen3-VL 8B
# (type=qwen_image), NOT the Qwen 2.5 VL used by qwen-image-2512. The int8
# convrot DiT/encoder ship their own quantization metadata and load as-is.
# Requires ComfyUI v0.37.0+ (TextEncodeQwenImage21) and comfy-kitchen 0.2.35+.
# The prompt is encoded by TextEncodeQwenImage21, which emits BOTH conditioning
# branches; the official path pins cfg=1, so negative_prompt is a no-op.
# Sampling defaults (steps/cfg/sampler/scheduler) live in profiles.toml.
# The released scheduler shifts dynamically per resolution; the worker derives
# the shift from the profile's configured width/height (profiles.toml) and
# patches it in, so 2048x2048 output gets the shift the model was tuned for
# instead of the 1024x1024 value.
COMFY_QWEN21_UNET=qwen_image_2.1_int8_convrot.safetensors
COMFY_QWEN21_CLIP=qwen3vl_8b_int8_convrot.safetensors
COMFY_QWEN21_VAE=qwen_image_2.1_vae_bf16.safetensors

# --- Required: OpenFLUX.1 files ---
# OpenFLUX.1 (ostris) is a de-distilled Flux 1 schnell. Same Flux 1 architecture,
# so it reuses COMFY_FLUX1_CLIP_L, COMFY_FLUX1_T5, and COMFY_FLUX1_VAE above —
# only the UNet differs. The published file is fp8-quantized; the workflow loads
# it with weight_dtype=fp8_e4m3fn. Unlike flux1-dev / fluxed-up, OpenFLUX honors
# real cfg + real negative_prompt (distillation has been trained out).
# Sampling defaults (steps/cfg/sampler/scheduler) live in profiles.toml.
COMFY_OPENFLUX_UNET=openflux1-v0.1.0-fp8.safetensors

# --- Required: Qwen-Image-Edit Rapid AIO file (under models/checkpoints/) ---
# Phr00t/Qwen-Image-Edit-Rapid-AIO is an all-in-one checkpoint: UNet + CLIP + VAE
# merged into ONE file, loaded with CheckpointLoaderSimple (no separate CLIP/VAE
# env vars needed). It is a 4-step distilled accelerator merge — the worker pins
# cfg=1 with euler_ancestral/beta, so negative_prompt is a no-op (like
# flux1-dev). NSFW LoRAs are baked into the *-NSFW-* build; no trigger word needed.
# Sampling defaults (steps/cfg/sampler/scheduler) live in profiles.toml.
COMFY_QWEN_RAPID_CHECKPOINT=Qwen-Rapid-AIO-NSFW-v23.safetensors

# --- Optional (defaults shown) ---

# SAS_EXPIRY_HOURS=24
# POLL_INTERVAL_SECONDS=2
# VISIBILITY_TIMEOUT_SECONDS=300
# MAX_DEQUEUE_COUNT=3
